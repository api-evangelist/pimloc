      "item": [
        {
          "id": "64179cf4-9edb-4580-9745-77cc3169fed5",
          "name": "Fetch token",
          "request": {
            "name": "Fetch token",
            "description": {
              "content": "Exchange your client_id / client_secret (sent as HTTP Basic auth) for a short-lived JWT access token used to authenticate all other requests. Optionally pass a username to obtain a user access token (Enterprise Flow).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "Optional username to fetch a user-scoped access token (Enterprise Flow)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "411df570-f1b7-4e17-98d5-559f0b5d9757",
